set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR mips)
get_filename_component(WORKSPACE "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(SDK "${WORKSPACE}/sf3000toolchain/mipsel-buildroot-linux-gnu_sdk-buildroot")
set(CMAKE_C_COMPILER "${SDK}/opt/ext-toolchain/bin/mips-mti-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${SDK}/opt/ext-toolchain/bin/mips-mti-linux-gnu-g++")
set(CMAKE_SYSROOT "${SDK}/mipsel-buildroot-linux-gnu/sysroot")
set(DEVICE_FLAGS "-mips32r2 -march=mips32r2 -mtune=74kc -mdspr2 -mfp32 -mhard-float -mlong-calls -EL")
set(CMAKE_C_FLAGS_INIT "${DEVICE_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "${DEVICE_FLAGS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${DEVICE_FLAGS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${DEVICE_FLAGS}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
